# Vite normally exposes VITE_* variables to this browser application.
# These values point to the active GCS Books Supabase project.
VITE_SUPABASE_URL=https://ujrollnpifbbqduiucoe.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qoth8e1HUxQsrxgy5Q65lQ_ljb9PLCU

# Compatibility aliases also work because vite.config.ts allows NEXT_PUBLIC_*.
# Keep these values identical if your deployment platform injects the Next names.
NEXT_PUBLIC_SUPABASE_URL=https://ujrollnpifbbqduiucoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Qoth8e1HUxQsrxgy5Q65lQ_ljb9PLCU

# Shopify import configuration. Never put an Admin API token or app secret in
# VITE_* or NEXT_PUBLIC_* browser variables.
#
# Local development uses the Shopify CLI bridge. Production defaults to the
# secure OAuth bridge in /api and stores an encrypted connection per GCS Books
# user. Set client_credentials in Vercel only for a Shopify app and store owned
# by the same Shopify organization; this mode does not require browser approval.
# Required for local CLI mode. Optional in Vercel: the import dialog can accept
# the store at runtime, so it does not need to be hard-coded here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CONNECTION_MODE=oauth
# Optional browser-facing label for the Vercel UI. Keep this aligned with the
# server mode after configuring production credentials.
# VITE_SHOPIFY_CONNECTION_MODE=client_credentials
# Production: create a Shopify standalone/API-only app and add its credentials
# only to the Vercel server environment. The redirect URL must be registered in
# the Shopify app exactly as shown below for the production domain.
# SHOPIFY_APP_CLIENT_ID=your-shopify-app-client-id
# SHOPIFY_APP_CLIENT_SECRET=your-shopify-app-client-secret
# SHOPIFY_APP_REDIRECT_URI=https://quickbook-gcs.vercel.app/api/shopify/oauth/callback
# Generate two different random values for these server-only secrets:
#   openssl rand -base64 32
# SHOPIFY_TOKEN_ENCRYPTION_KEY=replace-with-a-random-server-secret
# SHOPIFY_OAUTH_STATE_SECRET=replace-with-a-different-random-server-secret
# For Vercel native server-to-server mode, set SHOPIFY_CONNECTION_MODE=client_credentials.
# It uses the same app client id/secret and refreshes the short-lived token on the server.
# Optional override for the permissions requested by first-use OAuth/CLI auth:
# SHOPIFY_OAUTH_SCOPES=read_orders,read_all_orders,read_products,read_inventory,read_shopify_payments
# SHOPIFY_CLI_SCOPES=read_orders,read_all_orders,read_products,read_inventory,read_shopify_payments
# Optional when the Shopify CLI executable is not on PATH:
# SHOPIFY_CLI_COMMAND=/absolute/path/to/shopify
